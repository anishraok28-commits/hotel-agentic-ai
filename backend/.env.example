# Backend environment variables
# Source of truth: docs/api-contract.md Section 6.2

# Backend listen port (default: 3000)
PORT=3000

# Runtime environment: local | staging | production
ENV=local

# Shared secret the Frontend sends as "Authorization: Bearer <token>".
# Required. Fail-fast if unset.
SERVICE_TOKEN=

# Rate limiting (defaults: window 60s, max 30 requests per window per IP)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30

# Comma-separated list of browser origins allowed to call the Backend.
# Defaults to http://localhost:5173 when unset.
ALLOWED_ORIGINS=http://localhost:5173

# Make.com webhook URLs (required in staging/production)
MAKE_BOOKING_WEBHOOK_URL=
MAKE_ROOM_SERVICE_WEBHOOK_URL=
MAKE_LATE_CHECKOUT_WEBHOOK_URL=

# QR token secret (required in production — default is dev-only, do NOT deploy with it)
QR_TOKEN_SECRET=dev-qr-secret-do-not-use-in-production

# Session TTL in hours (default: 24)
SESSION_TTL_HOURS=24

# SQLite database path (default: ./data/hotel.db for persistence)
# For dev/test, set to :memory: for ephemeral database
DB_PATH=./data/hotel.db
