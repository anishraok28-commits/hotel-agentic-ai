# Backend environment variables
# Source of truth: docs/api-contract.md Section 6.2

# Backend listen port (default: 3000)
PORT=3000

# Runtime environment: local | staging | production
ENV=local

# Make.com webhook URLs (required in staging/production)
MAKE_BOOKING_WEBHOOK_URL=
MAKE_ROOM_SERVICE_WEBHOOK_URL=
MAKE_LATE_CHECKOUT_WEBHOOK_URL=
