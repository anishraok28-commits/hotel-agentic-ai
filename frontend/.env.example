# Frontend environment variables (docs/api-contract.md section 6.1)
# VITE_* variables are the ONLY env vars the frontend may read. No secrets.

VITE_ENV=local
VITE_API_BASE_URL=https://api.example.com

# "false" disables the in-memory mock and enables real Backend HTTP.
# Leave unset (or "true") to keep mock-only submissions.
VITE_MOCK_API_ENABLED=false